# Secrets for the ops stack. Copy to ./env, chmod 600, fill in. Never commit
# the filled file; .dockerignore keeps it out of the image.
# Sources: the stellar CLI keychain that holds the bot identities
#   stellar keys secret pb-mm-fly --config-dir <keychain>
# or a running Fly Machine, which sees them as environment variables
#   fly machine exec <id> -a pagebook-bots "printenv PB_SECRET_PB_MM"
PB_SECRET_PB_MM=S...
PB_SECRET_PB_TRADER=S...
# Optional: a dedicated keepalive identity. The supervisor runs the daily
# keepalive as pb-keeper when this is set and as pb-mm otherwise.
# PB_SECRET_PB_KEEPER=S...
